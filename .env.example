# Copy to .env for local use, or paste these as variables in your host's
# dashboard. Never commit the filled-in .env — it is gitignored for a reason.

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Your own numeric Telegram chat ID. Strongly recommended: it is the only
# unforgeable way the bot knows who the admin is. Get it by messaging
# @userinfobot on Telegram.
ADMIN_CHAT_ID=123456789

# ─── Google Sheets ───────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=1DU7CqxBN4OB_AoTOXEUcy0XfTVakrJzX8dwhU9uwrxk

# From the service-account JSON key: "client_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL=digital-shop-bot@your-project.iam.gserviceaccount.com

# From the service-account JSON key: "private_key".
# Keep the literal \n sequences and wrap the whole thing in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# ─── Order Desk ──────────────────────────────────────────────────────────────
# The Apps Script order desk's spreadsheet. Completed sales are recorded there
# so Renewals, Reports and the 14-day calendar reminders cover Telegram
# customers alongside TikTok and Viber ones.
# Leave blank to switch the sync off — the bot works exactly as before.
# The service account above must be shared into this sheet as an Editor.
DESK_SHEET_ID=1NW6CtFW46zv_NnClS1ENzmpdEkjuH-oYD1olU92sgeI

# ─── Zoom reminders ──────────────────────────────────────────────────────────
# Calendar that the 14-day Zoom reminders are written to, as soon as the
# customer sends their email. Leave blank to switch instant creation off — the
# Apps Script sweep still catches everything within 5 minutes.
#
# The calendar must be SHARED with the service account above, with
# "Make changes to events". Nothing arrives by email; it just gains access.
REMINDER_CALENDAR_ID=yeemonmontin71@gmail.com

# ─── Timezone ────────────────────────────────────────────────────────────────
# Servers default to UTC. Set this or your order timestamps will be wrong.
TZ=Asia/Yangon

# ─── Payslip checker (optional) ──────────────────────────────────────────────
# Reads each payment slip with Claude and puts a verdict on the message the
# admin gets: amount matches? sent to your account? recent? txn number new?
# It never approves or rejects anyone by itself. Leave SLIP_API_KEY blank
# to keep the bot working exactly as before.
#
# Which provider? Either of these works — only these lines change:
#   A) Official:  key from platform.claude.com (starts sk-ant-)
#        SLIP_API_BASE_URL=https://api.anthropic.com   (or leave it out)
#   B) Reseller:  e.g. ORYNX prepaid key (starts sk-orynx-)
#        SLIP_API_BASE_URL=https://api.orynx.dev       (host only, no /v1)
# When a prepaid key expires or runs out: see SLIP-KEY-RENEWAL.md.
SLIP_API_KEY=
SLIP_API_BASE_URL=
SLIP_MODEL=claude-haiku-4-5
# Only if the provider can't report it: the day the key expires, for reminders.
# SLIP_KEY_EXPIRES=2027-01-08

# Your own receiving accounts, as "Name as shown on slips|last digits",
# separated by semicolons. Leave blank to skip the "sent to me?" check.
# One entry per receiving account/wallet/phone (last 4 digits); same name is fine:
# Example: SLIP_RECEIVERS=Your Name|1111;Your Name|2222;Your Name|3333
# Paid in baht? Set what 1 THB is worth to you in MMK so amounts can be compared:
# SLIP_THB_MMK_RATE=128   # kyat per baht: your agent's baht->kyat rate (e.g. 131.6) minus 2-3% safety. Review often.
# SLIP_RATE_TOLERANCE_PCT=3
SLIP_RECEIVERS=

# Optional tuning (defaults shown):
# SLIP_CHECK=off                     # switch the checker off without removing the key
# SLIP_MAX_AGE_MIN=120               # slips older than this are flagged
# SLIP_DEFAULT_TZ_OFFSET_MIN=390     # slip clock when not a Thai bank (Myanmar = +6:30)
# (SLIP_MODEL above: use a bigger model, e.g. claude-sonnet-4-5, if it misreads blurry slips)
# SLIP_BALANCE_CHECK=off             # skip asking a reseller for credit/expiry

# If the provider stalls, a parallel request starts after this many ms (first answer wins)
# SLIP_HEDGE_MS=6000
# SLIP_MAX_ATTEMPTS=2

# Official Anthropic key (platform.claude.com). When set, it is tried FIRST and SLIP_API_KEY above
# becomes the backup (e.g. the ORYNX key). Only one of the two is also fine.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_KEY_EXPIRES=2027-10-01     # the date you chose when creating the key
# SLIP_MODEL_OFFICIAL=claude-haiku-4-5 # try claude-haiku-5-5 (cheaper) after testing it on your sample slips

# ── Staff slip-check bot (staff-bot.js) — a SEPARATE bot, its own token ──────────
# Create it with @BotFather. Must NOT be the same bot as TELEGRAM_BOT_TOKEN.
# STAFF_BOT_TOKEN=
# Staff who may SEND slips: Telegram numeric IDs (best — they never change) and/or @usernames,
# separated by commas. ADMIN_CHAT_ID is always allowed too.
# STAFF_ALLOWED=111111111,222222222
# Supervisors who may press the ✅ / ❌ buttons under a verdict but cannot send slips.
# Someone in both lists can do both. ADMIN_CHAT_ID is always both.
# STAFF_APPROVERS=333333333
